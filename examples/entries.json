{
    "entries": [
        {
            "type": "start_app",
            "executable": "okular",
            "env": {
                "QT_SCALE_FACTOR": "1.5"
            }
        },
        {
            "type": "start_app",
            "entry_label": "nautilus | files | Downloads (floating)",
            "executable": "nautilus",
            "executable_args": [
                "--new-window",
                "~/Downloads"
            ],
            "floating": true,
            "floating_size": "60%x70%",
            "floating_position": "center",
            "window_class": "nautilus"
        },
        {
            "type": "claude",
            "cwd": "~/projects/app",
            "terminal_below": true
        },
        {
            "type": "claude",
            "entry_label": "claude | app + listing",
            "cwd": "~/projects/app",
            "workspace": "claude [app listing]",
            "terminal_below": {
                "command": "ls -la; exec $SHELL",
                "height": "30%"
            }
        },
        {
            "type": "open_web",
            "url": "https://github.com/"
        },
        {
            "type": "web_list",
            "entry_label": "Links",
            "browser": "firefox",
            "urls": [
                {
                    "url": "https://github.com/",
                    "label": "GitHub"
                },
                {
                    "url": "https://recipes.example.com/spaghetti-carbonara",
                    "label": "Spaghetti Carbonara",
                    "subgroup": "Food Recipes"
                },
                {
                    "url": "https://recipes.example.com/chicken-tikka-masala",
                    "label": "Chicken Tikka Masala",
                    "subgroup": "Food Recipes"
                },
                {
                    "url": "https://recipes.example.com/banana-pancakes",
                    "label": "Banana Pancakes",
                    "subgroup": "Food Recipes"
                }
            ]
        },
        {
            "type": "start_app",
            "executable": "vlc",
            "active": false
        }
    ]
}
